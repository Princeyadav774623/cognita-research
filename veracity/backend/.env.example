# Two roles, or row-level security has no effect. See app/db/rls.py.
DATABASE_URL=postgresql://localhost:5432/veracity
DATABASE_URL_APP=postgresql://veracity_app:CHANGE_ME@localhost:5432/veracity

GROQ_API_KEY=

# groq | faster-whisper
ASR_BACKEND=groq
ASR_MODEL=whisper-large-v3-turbo

MEDIA_ROOT=/tmp/veracity-media

# Fetching from third-party hosts can breach their terms of service.
# Off unless you have decided it is appropriate for your deployment.
ALLOW_REMOTE_FETCH=false

# Local development only.
ALLOW_GUEST=true

# Allowances. These defaults are the production ones; raise them in .env for
# local work rather than editing app/quota.py, or the change ships.
# FREE_TRANSCRIPTION_MINUTES=120
# FREE_ANALYSIS_CREDITS=60
# FREE_COST_USD=1.0
