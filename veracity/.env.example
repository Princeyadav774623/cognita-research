# docker compose reads this file. Copy to .env and fill it in.
POSTGRES_PASSWORD=change-me
APP_PASSWORD=change-me-too
GROQ_API_KEY=
TAVILY_API_KEY=

# Production should set one of these and leave ALLOW_GUEST false.
SUPABASE_JWKS_URL=
JWT_SECRET=
ALLOW_GUEST=false

# Downloading from third-party hosts may breach their terms of service.
ALLOW_REMOTE_FETCH=false

# local keeps files on one machine. s3 lets the API and worker be separate
# hosts; with the s3 profile, MinIO provides it locally.
#   docker compose --profile s3 up
STORAGE_BACKEND=local
S3_BUCKET=veracity
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

LOG_FORMAT=json
LOG_LEVEL=INFO

API_PORT=8080
WEB_PORT=5174
WORKER_REPLICAS=1
