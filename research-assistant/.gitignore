# Environment / secrets
.env
backend/.env
*.env
# Backups of a real .env carry live API keys and DB passwords; nothing matching
# .env with a suffix should ever be committable.
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# Database
*.db
*.sqlite3

# Frontend
node_modules/
frontend/dist/
frontend/build/

# Editor / OS
.DS_Store
.vscode/

# Labelling exports from evals/factcheck_accuracy.py — these contain claim
# text and session ids pulled from the database, not source code.
backend/claims*.jsonl
backend/*.labels.jsonl
