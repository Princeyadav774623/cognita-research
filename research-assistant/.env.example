# =============================================
#   COPY THIS FILE TO .env AND FILL IN VALUES
# =============================================

# Groq API — groq.com (free)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily Search — tavily.com (free 1000/month)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cohere Embeddings — cohere.com (free)
COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LangSmith Tracing — smith.langchain.com (free), entirely optional.
# Left off by default: turning it on with the placeholder key below makes every
# LLM call also attempt a trace upload that can only fail. Set the key first,
# then flip this to true.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=research-assistant

# Supabase Database — supabase.com (free)
DATABASE_URL=postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres

# Supabase Auth — used to verify user JWTs via the project's public JWKS
SUPABASE_URL=https://your-project.supabase.co

# Low-privilege DB role (no BYPASSRLS) — create it once via SQL, see README.
# Runtime queries use this so RLS policies are real defense-in-depth.
APP_DATABASE_URL=postgresql://app_service.xxxx:yourpassword@db.xxxx.supabase.co:5432/postgres

# Billing — Stripe (optional). Leave blank to keep the billing endpoints in
# demo mode. STRIPE_WEBHOOK_SECRET is mandatory once billing is live: the
# webhook refuses to process events it cannot cryptographically verify.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# App settings
ENV=development
PORT=8000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS_RAW=http://localhost:3000
