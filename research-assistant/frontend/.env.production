# Production build values. Vite prefers .env.production over .env when
# running `npm run build`, which is what stops the dev value
# (http://localhost:8000) from being inlined into the shipped bundle.
#
# VITE_API_URL is deliberately EMPTY: an empty base makes the browser call
# /api/... on its own origin, and nginx reverse-proxies through to the
# backend (see nginx.conf). That means the backend port never has to be
# publicly reachable, and the same bundle works on any domain.
VITE_API_URL=

# These are public by design (Supabase anon keys are safe in a client
# bundle; row-level security is what protects the data). Override at build
# time in CI if you use a different project for production.
VITE_SUPABASE_URL=https://birxycoynsaqlhreesoz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Li6jn_qhmO98nKkPATQKLw_TM9xWTT5
